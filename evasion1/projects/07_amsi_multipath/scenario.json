{
  "id": "A07",
  "title": "AMSI multi-path validation",
  "standalone": true,
  "source": [
    "main.c",
    "simulator.c"
  ],
  "platform": "Windows 10+",
  "linked_libraries": [
    "amsi.lib",
    "bcrypt.lib",
    "version.lib"
  ],
  "execution_tiers": {
    "native": "real Windows AMSI integration",
    "simulator": "deterministic telemetry-only regression control"
  },
  "runtime_inputs": {
    "external_file": "optional local native validation input; not stored in repository",
    "repeat_count": "1..100 for simulator, 1..20 for native harness"
  },
  "simulator_scenarios": [
    "stable",
    "result-flip",
    "hresult-failure",
    "cross-path-drift"
  ],
  "telemetry": "evasion1-jsonl-v2",
  "safety": {
    "local_only": true,
    "payload_execution": false,
    "remote_process_access": false,
    "security_product_tampering": false,
    "kernel_memory_modification": false,
    "credential_access": false,
    "native_amsi_patch": false,
    "embedded_amsi_test_signature": false,
    "simulation_distinguished_from_native": true
  },
  "detection_objective": "measure native AMSI path consistency and provide deterministic positive/negative controls for EDR correlation"
}
